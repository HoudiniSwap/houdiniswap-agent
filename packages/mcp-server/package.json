{
  "name": "@houdiniswap/mcp-server",
  "version": "0.1.6",
  "description": "HoudiniSwap MCP server — connect AI agents to 14 CEXes and 20+ DEXes via Model Context Protocol",
  "type": "module",
  "license": "MIT",
  "author": "HoudiniSwap (https://houdiniswap.com)",
  "homepage": "https://github.com/HoudiniSwap/houdiniswap-agent#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HoudiniSwap/houdiniswap-agent.git",
    "directory": "packages/mcp-server"
  },
  "bugs": "https://github.com/HoudiniSwap/houdiniswap-agent/issues",
  "keywords": [
    "houdiniswap",
    "mcp",
    "model-context-protocol",
    "crypto",
    "swap",
    "bridge",
    "x402",
    "ai-agent"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "bin": {
    "houdiniswap-mcp": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@houdiniswap/agent-shared": "^0.1.3",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "express": "^4.21.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
